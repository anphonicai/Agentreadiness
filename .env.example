# Run: node --env-file=.env server.js (Node 22.13+)
PORT=3100
# Enable the email preview only on a local development server.
REPORT_EMAIL_PREVIEW=1
# Live delivery uses a verified sender, a Resend API key and the deployed HTTPS URL.
# Set NODE_ENV=production and REPORT_EMAIL_PREVIEW=0 in production.
# PUBLIC_APP_URL=https://commerce.anphonic.ai
# REPORT_EMAIL_FROM=reports@anphonic.ai
# RESEND_API_KEY=
# REPORTS_DB_PATH=/persistent-disk/reports.sqlite
# LEADS_DB_PATH=/persistent-disk/leads.sqlite

# Stripe Checkout ($249 USD); use test keys until end-to-end testing is complete.
# Checkout stays in demo mode until BOTH of these, PUBLIC_APP_URL, RESEND_API_KEY
# and REPORT_EMAIL_FROM are all set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Discount / full-access codes, comma separated: CODE[:percentOff[:maxUses]]
# percentOff defaults to 100, maxUses to unlimited.
#   100% -> unlocks the full report immediately, no payment and no Stripe call
#   <100 -> applied as a discount on the Stripe Checkout session
# Stripe's own promotion codes also work on the checkout page when no code is
# entered here. Codes are case-insensitive; keep them at least 3 characters.
# REPORT_ACCESS_CODES=FOUNDER, PARTNER50:50:25, PRESS:100:10
